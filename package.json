{
  "name": "meetrec",
  "productName": "MeetRec",
  "version": "1.2.0",
  "description": "Grave reuniões (microfone + som do computador), transcreva e gere resumos com o Claude Code.",
  "main": "src/main/main.js",
  "author": {
    "name": "luiscriativo",
    "email": "luiscriativo@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test \"test/**/*.test.js\"",
    "whisper": "node scripts/fetch-whisper.js",
    "icons": "node scripts/gen-icons.js",
    "dist": "npm run whisper && electron-builder --publish never",
    "dist:win": "npm run whisper && electron-builder --win --publish never",
    "dist:mac": "npm run whisper && electron-builder --mac --publish never",
    "dist:linux": "npm run whisper && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5"
  },
  "homepage": "https://github.com/luiscriativo/meetrec",
  "repository": {
    "type": "git",
    "url": "https://github.com/luiscriativo/meetrec.git"
  }
}
